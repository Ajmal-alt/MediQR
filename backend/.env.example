# MediQR Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# MySQL Database (use your RDS endpoint in production)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=mediqr3
DB_PORT=3306

# JWT Secret - CHANGE THIS in production!
JWT_SECRET=mediqr_v3_secret_key_change_in_production

# Public URL of your server (used for video URLs)
PUBLIC_URL=http://localhost:3000

# AWS S3 (for videos/images storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
S3_BUCKET_NAME=mediqr-media
